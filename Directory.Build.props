<Project>

	<PropertyGroup>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)/strongname.snk</AssemblyOriginatorKeyFile>
		<SignAssembly>True</SignAssembly>
		<PublicKey></PublicKey>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The oldest Roslyn the analyzers and code fixers must load in. A compiler host older than the referenced
		version refuses to load them (CS9057) and silently skips all diagnostics and code fixes. Same floor as aweXpect;
		raise it only when a needed API requires it. -->
		<MinimumRoslynVersion>4.8.0</MinimumRoslynVersion>
	</PropertyGroup>

</Project>
